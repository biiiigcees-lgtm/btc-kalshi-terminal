{
  "name": "btc-terminal-v3",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node app-server.js",
    "start": "node app-server.js",
    "alpha:dev": "bash scripts/dev.sh",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "ci:leakage-guard": "node scripts/ci-leakage-guard.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "express": "^4.21.2",
    "http-server": "^14.1.1",
    "ioredis": "^5.8.1",
    "next": "^16.2.4",
    "prisma": "^7.8.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
