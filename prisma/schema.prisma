generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model backtest_runs {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  total_signals    Int
  total_trades     Int
  wins             Int
  accuracy         Float
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  backtest_signals backtest_signals[]
}

model backtest_signals {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  run_id        String        @db.Uuid
  signal_index  Int
  take_trade    Boolean
  correct       Boolean?
  payload       Json
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  backtest_runs backtest_runs @relation(fields: [run_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model event_log {
  id         String   @id @db.Uuid
  event_type String
  ts         DateTime @db.Timestamptz(6)
  payload    Json
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model metric_snapshots {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope       String
  equity      Float
  peak_equity Float
  drawdown    Float
  exposure    Float    @default(0)
  pnl         Float    @default(0)
  trade_count Int      @default(0)
  payload     Json     @default("{}")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([scope, created_at(sort: Desc)])
}

model model_registry {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model_name    String
  model_version String
  brier_score   Float?
  accuracy      Float?
  trained_at    DateTime @default(now()) @db.Timestamptz(6)
  payload       Json
}

model paper_trades {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  probability      Float
  cost             Float
  outcome          Boolean?
  payout           Float
  expected_value   Float
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  signal_id        String?   @db.Uuid
  decision_id      String?   @db.Uuid
  action           String    @default("HOLD")
  mode             String?
  regime           String?
  size             Float     @default(0)
  entry_price      Float     @default(0)
  exit_price       Float?
  pnl              Float?
  resolved         Boolean   @default(false)
  resolved_at      DateTime? @db.Timestamptz(6)
  feature_snapshot Json      @default("{}")
  model_scores     Json      @default("{}")
  weights          Json      @default("{}")

  @@index([created_at(sort: Desc)])
  @@index([regime, created_at(sort: Desc)], map: "paper_trades_regime_idx")
  @@index([resolved, resolved_at(sort: Desc)], map: "paper_trades_resolved_idx")
}

model session_state {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_date DateTime  @unique @db.Date
  opened_at    DateTime  @default(now()) @db.Timestamptz(6)
  reset_at     DateTime? @db.Timestamptz(6)
  pnl          Float     @default(0)
  peak_equity  Float     @default(0)
  drawdown     Float     @default(0)
  trade_count  Int       @default(0)
  payload      Json      @default("{}")
}

model signal_log {
  signal_id               String   @id @db.Uuid
  ts                      DateTime @db.Timestamptz(6)
  probability             Float
  confidence              Float
  expected_value          Float
  action                  String
  regime                  String?
  payload                 Json
  calibrated_probability  Float?
  calibration_method      String?
  baseline_random         Float?
  baseline_momentum       Float?
  baseline_moving_average Float?
}

model trade_outcomes {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  signal_id              String   @db.Uuid
  trade_id               String?  @db.Uuid
  resolved_at            DateTime @db.Timestamptz(6)
  predicted_probability  Float
  outcome                Int
  brier                  Float
  payload                Json
  calibrated_probability Float?
  raw_brier              Float?
  calibrated_brier       Float?
  pnl                    Float?
}
