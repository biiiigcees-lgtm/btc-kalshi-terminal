NODE_ENV=development
DATABASE_URL=postgresql://trader:trader@db:5432/btc
EVENT_CHANNEL=trading_events
REDIS_URL=redis://redis:6379
REGIME_COOLDOWN_MS=5000

# execution and outcome
EXECUTION_MODE=paper
OUTCOME_DELAY_MS=900000
EV_THRESHOLD=0
CALIBRATION_WINDOW=2000
MIN_CALIBRATION_SAMPLES=80
MIN_CONFIDENCE=0.65
EV_CONFIDENCE_Z=1.28
SIGNAL_DECAY_MIN_MS=30000
SIGNAL_DECAY_MAX_MS=90000
FILL_DELAY_MIN_MS=1000
FILL_DELAY_MAX_MS=3000
BASE_SLIPPAGE_BPS=2
LIQUIDITY_IMPACT_BPS=20
SPREAD_WIDENING_MULTIPLIER=0.4
WEIGHT_SMOOTHING_ALPHA=0.2
WEIGHT_PERF_DECAY=0.9
MIN_SHARPE_FOR_TRADING=0
VALIDATION_WINDOW=800
MIN_VALIDATION_SAMPLES=60
DIVERGENCE_ALERT_THRESHOLD=0.12
MODEL_IMPROVEMENT_DELTA=0.003
MIN_SHARPE_FOR_DEPLOY=0
PURGED_WF_FOLDS=5
PURGE_SAMPLES=5
EMBARGO_SAMPLES=5
LEAKAGE_MAX_CLOCK_SKEW_MS=1500

# risk service limits (institutional-style)
NOTIONAL_BANKROLL=10000
MAX_TRADE_RISK_PCT=0.25
MAX_DAILY_LOSS_PCT=2
MAX_DRAWDOWN_PCT=5
MAX_EXPOSURE_PER_REGIME_PCT=40
COOLDOWN_AFTER_LOSS_TRADES=3
MAX_BACKTEST_PROJECTED_LOSS=800
COOLDOWN_MINUTES=30
DRAWDOWN_VELOCITY_LIMIT=5
MODEL_PATH=/models/model.onnx
