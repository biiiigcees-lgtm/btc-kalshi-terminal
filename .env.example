NODE_ENV=development
DATABASE_URL=postgresql://trader:trader@db:5432/btc
EVENT_CHANNEL=trading_events
REDIS_URL=redis://redis:6379

# execution and outcome
EXECUTION_MODE=paper
OUTCOME_DELAY_MS=900000
EV_THRESHOLD=2.5
CALIBRATION_WINDOW=2000

# risk service limits (institutional-style)
NOTIONAL_BANKROLL=10000
MAX_TRADE_RISK_PCT=0.25
MAX_DAILY_LOSS_PCT=2
MAX_DRAWDOWN_PCT=5
MAX_EXPOSURE_PER_REGIME_PCT=40
COOLDOWN_AFTER_LOSS_TRADES=3
MAX_BACKTEST_PROJECTED_LOSS=800
COOLDOWN_MINUTES=30
MODEL_PATH=/models/model.onnx
