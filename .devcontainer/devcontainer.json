{
  "name": "btc-terminal-v3",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 4001, 4002, 4003, 4004],
  "postCreateCommand": "npm install && cp .devcontainer/zshrc /root/.zshrc",
  "extensions": [
    "dbaeumer.vscode-eslint",
    "Prisma.prisma",
    "ms-azuretools.vscode-docker",
    "ms-python.python"
  ]
}
